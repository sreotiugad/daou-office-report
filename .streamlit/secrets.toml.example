# 이 파일을 secrets.toml 로 복사한 뒤 실제 값을 채우세요.
# (secrets.toml 은 .gitignore 로 커밋에서 제외됩니다.)
# Streamlit Community Cloud 배포 시에는 앱 Settings > Secrets 에 아래 내용을 붙여넣으세요.

# ── 구글 Ads API ──────────────────────────────────
GADS_DEVELOPER_TOKEN = "your_developer_token"
GADS_CLIENT_ID = "your_client_id"
GADS_CLIENT_SECRET = "your_client_secret"
GADS_REFRESH_TOKEN = "your_refresh_token"
GADS_LOGIN_CUSTOMER_ID = "1234567890"          # MCC 관리계정 ID (하이픈 없이)
GADS_CUSTOMER_IDS = "1234567890,0987654321"    # 조회할 계정 ID들 (콤마 구분)

# ── 메타(페이스북) API ────────────────────────────
META_ACCESS_TOKEN = "your_long_lived_access_token"
META_AD_ACCOUNT_ID = "act_1234567890"

# ── 네이버 검색광고 API (있으면 네이버 업로드 대신 API 사용) ──
# 네이버 검색광고 → 도구 → API 사용 관리에서 발급
NAVER_CUSTOMER_ID = "1918998"           # 광고주(Customer) ID
NAVER_API_KEY = "your_access_license"    # 액세스라이선스
NAVER_SECRET_KEY = "your_secret_key"     # 비밀키

# ── GA4 Data API ──────────────────────────────────
# 서비스 계정 JSON 전체를 한 줄 문자열(또는 아래 [.] 테이블)로 넣습니다.
GA4_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "xxx@xxx.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''
GA4_PROPERTY_DO = "111111111"    # 다우오피스 GA4 속성 ID (숫자)
GA4_PROPERTY_HR = "222222222"    # 다우오피스HR GA4 속성 ID (숫자)
